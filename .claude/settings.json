{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "autoMemoryEnabled": false,
  "plansDirectory": "docs/superpowers/plans",
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python -m unittest discover -s tests *)",
      "Bash(python3 .claude/skills/live-check/check.py *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(gcloud storage ls *)",
      "Bash(gcloud run services describe *)",
      "Bash(gcloud run revisions list *)"
    ],
    "ask": [
      "Bash(./deploy.sh *)",
      "Bash(gcloud run deploy *)",
      "Bash(gcloud run services delete *)",
      "Bash(gcloud storage rm *)",
      "Bash(gcloud storage buckets delete *)",
      "Bash(gcloud storage buckets add-iam-policy-binding *)",
      "Bash(gcloud storage buckets remove-iam-policy-binding *)",
      "Bash(git push *)",
      "Bash(bash deploy.sh *)",
      "Bash(gcloud projects add-iam-policy-binding *)",
      "Bash(gcloud secrets add-iam-policy-binding *)"
    ],
    "deny": [
      "Bash(gcloud storage buckets add-iam-policy-binding *allUsers*)",
      "Bash(gcloud storage buckets add-iam-policy-binding *allAuthenticatedUsers*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*credentials*.json)",
      "Read(./**/*service-account*.json)",
      "Bash(gcloud secrets versions access *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_context.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_deploy.py\"",
            "timeout": 150
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/after_edit.py\"",
            "timeout": 150
          }
        ]
      }
    ]
  }
}
